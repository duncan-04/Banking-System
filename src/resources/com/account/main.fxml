<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="450.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.account.LoginViewController">

    <children>

        <Text layoutX="85.0" layoutY="41.0"
              text="BANKING SYSTEM">
            <font>
                <Font size="17.0"/>
            </font>
        </Text>

        <Text layoutX="85.0" layoutY="73.0"
              text="Sign in to manage your accounts"/>

        <Text layoutX="85.0" layoutY="101.0"
              text="Customer ID"/>

        <TextField fx:id="customerIdField"
                   layoutX="85.0" layoutY="116.0"
                   prefHeight="34.0" prefWidth="510.0"
                   promptText="Enter customer ID"/>

        <Text layoutX="85.0" layoutY="181.0"
              text="Password"/>

        <PasswordField fx:id="passwordField"
                       layoutX="85.0" layoutY="196.0"
                       prefHeight="34.0" prefWidth="510.0"
                       promptText="Enter password"/>

        <Button layoutX="85.0" layoutY="263.0"
                prefHeight="35.0" prefWidth="510.0"
                text="Login"
                onAction="#handleLogin"/>

        <Button layoutX="85.0" layoutY="315.0"
                prefHeight="35.0" prefWidth="150.0"
                text="Clear"
                onAction="#handleClear"/>

        <Button layoutX="255.0" layoutY="315.0"
                prefHeight="35.0" prefWidth="340.0"
                text="Create Account"
                onAction="#handleCreateAccount"/>

        <Label fx:id="messageLabel"
               layoutX="85.0" layoutY="370.0"
               prefWidth="510.0"
               wrapText="true"/>

    </children>
</AnchorPane>